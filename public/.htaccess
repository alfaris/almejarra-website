# Hostinger (LiteSpeed/Apache) settings for the static build.

<IfModule mod_rewrite.c>
  RewriteEngine On

  # One canonical host: https://almejarra.com.
  # www → apex (also upgrades to https in the same hop).
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301,NE]
  # http → https. The X-Forwarded-Proto check avoids a redirect loop if a CDN terminates TLS.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301,NE]

  # Pages from the old WordPress site (2015–2025) → their closest page today,
  # so old press links, directory links and bookmarks keep working.
  RewriteRule ^(honors-board|teams|join-the-astronauts)/?$ /team/ [L,R=301]
  RewriteRule ^(almejarra-coworking-space|المجرة)/?$ /#about [L,R=301,NE]
  RewriteRule ^(coworking-spaces|almejarra-shuttle|almejarra-capsule|almejarra-planet)/?$ /#spaces [L,R=301,NE]
  RewriteRule ^community/?$ /#community [L,R=301,NE]
  RewriteRule ^faq/?$ /#faq [L,R=301,NE]
  RewriteRule ^(connect-almejarra|reserve-space|reserve-shuttle|f|f/interested|interested)/?$ /#contact [L,R=301,NE]
  RewriteRule ^(feed|comments/feed|wp-admin|wp-login\.php|wp-content/.*|wp-json/.*|xmlrpc\.php)/?$ / [L,R=301]
</IfModule>

# Branded "page not found" page.
ErrorDocument 404 /404.html

# Compress text assets.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  # Pages change on every deploy: always revalidate.
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/xml "access plus 1 day"
  ExpiresByType text/plain "access plus 1 day"
  # Photos, video and icons.
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType video/mp4 "access plus 30 days"
</IfModule>

# Build assets have content hashes in their names, so they can be cached for a year.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

AddType video/mp4 .mp4
AddType image/webp .webp
AddType font/woff2 .woff2
